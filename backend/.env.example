NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=data/gestao.sqlite
UPLOADS_PATH=data/uploads
# npm run setup gera um segredo criptográfico individual automaticamente.
JWT_SECRET=
JWT_EXPIRES_IN=8h

# E-mail: em desenvolvimento, sem SMTP, mensagens vão para data/outbox.
# Em produção, configure o provedor real. Nunca coloque credenciais no frontend.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
